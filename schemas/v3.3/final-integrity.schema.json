{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"final-integrity.schema.json",
  "type":"object",
  "required":[
    "content_address","knowledge","claims","terminology","narrative","factual","naturalness","proof",
    "candidate_conservation_proof","temporal_proofs","claim_conservation_proof",
    "naturalness_finding_conservation_proof","isolation_status","content_integrity_status",
    "proof_verifier_status","project_status"
  ],
  "properties":{
    "content_address":{"$ref":"audit-envelope.schema.json#/$defs/content_address"},
    "knowledge":{
      "type":"object",
      "required":[
        "core_entities_ungrounded","unmapped_aliases","missing_discovered_nodes","unresolved_concepts",
        "unresolved_dependencies","unresolved_relations","temporal_first_use_failures",
        "confusable_pairs_unresolved","silently_ignored_candidates","invalid_baseline_provenance"
      ],
      "additionalProperties":true
    },
    "claims":{
      "type":"object",
      "required":["missing_claim_sentence_rows","unconserved_claims","unresolved_claims","invalid_evidence_links"],
      "additionalProperties":true
    },
    "terminology":{
      "type":"object",
      "required":["unnecessary_labels","alias_overload"],
      "additionalProperties":true
    },
    "narrative":{
      "type":"object",
      "required":["redundant_reveals","high_load_listening_blocks"],
      "additionalProperties":true
    },
    "factual":{
      "type":"object",
      "required":["unsupported_claims","certainty_overstatements","unsupported_temporal_generalizations","scope_overstatements"],
      "additionalProperties":true
    },
    "naturalness":{
      "type":"object",
      "required":["translationese_flags","repeated_rhetorical_patterns","unresolved_audio_density_flags","unresolved_naturalness_findings"],
      "additionalProperties":true
    },
    "proof":{
      "type":"object",
      "required":[
        "schema_failures","hash_failures","stale_audit_failures","sentence_coverage_failures",
        "candidate_conservation_failures","claim_conservation_failures","finding_conservation_failures",
        "temporal_proof_failures","isolation_failures"
      ],
      "additionalProperties":true
    },
    "candidate_conservation_proof":{"type":"object","required":["discovered_candidate_ids","dispositions"]},
    "temporal_proofs":{"type":"array"},
    "claim_conservation_proof":{"type":"object","required":["discovered_claim_ids","dispositions"]},
    "naturalness_finding_conservation_proof":{"type":"object","required":["discovered_finding_ids","dispositions"]},
    "isolation_status":{"type":"string"},
    "content_integrity_status":{"type":"string"},
    "proof_verifier_status":{"type":"string"},
    "project_status":{"type":"string"}
  }
}