{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-ledger.schema.json",
  "type": "object",
  "required": ["evidence"],
  "properties": {
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "claim_ids", "source_id", "locator", "support_mode", "evidence_summary", "limitations"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^E[0-9]+$"},
          "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_id": {"type": "string"},
          "locator": {"type": "string", "minLength": 1},
          "support_mode": {"enum": ["DIRECT", "INFERENCE", "CONTEXT"]},
          "evidence_summary": {"type": "string", "minLength": 1},
          "limitations": {"type": "string"}
        }
      }
    }
  }
}