{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim-map.schema.json",
  "type": "object",
  "required": ["claims", "status"],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "claim", "source_ids", "evidence_ids", "confidence", "allowed_certainty", "time_scope", "geographic_scope", "population_scope"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^C[0-9]+$"},
          "claim": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "confidence": {"type": "string"},
          "allowed_certainty": {},
          "time_scope": {},
          "geographic_scope": {},
          "population_scope": {}
        }
      }
    },
    "status": {"type": "string"}
  }
}