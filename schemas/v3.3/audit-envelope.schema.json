{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit-envelope.schema.json",
  "$defs": {
    "hash_ref": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "content_address": {
      "type": "object",
      "required": ["hash_algorithm", "inputs"],
      "properties": {
        "hash_algorithm": {"const": "sha256"},
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/hash_ref"}
        },
        "input_script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "output_script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "type": "object",
  "required": ["content_address"],
  "properties": {
    "content_address": {"$ref": "#/$defs/content_address"}
  }
}