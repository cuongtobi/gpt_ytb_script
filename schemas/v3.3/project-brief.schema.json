{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-brief.schema.json",
  "type": "object",
  "required": ["project", "pipeline"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["topic", "language", "locale", "duration_minutes"],
      "properties": {
        "topic": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "locale": {"type": "string", "minLength": 2},
        "duration_minutes": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "pipeline": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": {"const": "3.3"},
        "artifact_schema_version": {"const": "3.3.0"},
        "segmenter_version": {"const": "3.3.0"}
      }
    }
  }
}